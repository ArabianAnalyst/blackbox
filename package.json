{
  "name": "@olurabian/blackbox",
  "version": "0.2.0",
  "description": "A tamper-evident flight recorder for AI agents. Records every action to a hash-chained log you can prove was not altered. Zero third-party dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "demo": "tsx examples/demo.ts",
    "test": "tsx test/hash.test.ts && tsx test/store.test.ts && tsx test/recorder.test.ts && tsx test/verify.test.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "observability",
    "audit",
    "governance",
    "tamper-evident",
    "agentic"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Oluwasegun Araba (ARABA)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArabianAnalyst/blackbox"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "@lavamoat/allow-scripts": "^5.1.0"
  },
  "dependencies": {
    "@olurabian/receipt": "^0.1.0"
  },
  "lavamoat": {
    "allowScripts": {
      "tsx>esbuild#0.28.1": true
    }
  }
}
